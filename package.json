{
  "name": "hxo-trust-kit",
  "version": "1.1.0",
  "private": true,
  "description": "HXO Trust and Control Kit: React components that mirror the Figma library for human-agent trust and control patterns.",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit",
    "test:stories": "node scripts/verify-stories.mjs",
    "build-pages": "storybook build -o docs && touch docs/.nojekyll"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.4.7",
    "@storybook/addon-essentials": "8.4.7",
    "@storybook/addon-themes": "8.4.7",
    "@storybook/blocks": "8.4.7",
    "@storybook/manager-api": "8.4.7",
    "@storybook/react": "8.4.7",
    "@storybook/react-vite": "8.4.7",
    "@storybook/theming": "8.4.7",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.10.2",
    "storybook": "8.4.7",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
